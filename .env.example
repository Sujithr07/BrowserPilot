# ─────────────────────────────────────────────────────────────────────────────
# AgentFlow configuration. Copy to `.env` and fill in at least ONE provider key.
#   cp .env.example .env
# All keys/knobs are optional unless noted; backend/llm.py and backend/config.py
# read them via the environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Provider API keys ────────────────────────────────────────────────────────
# LiteLLM picks each key up automatically by name. You only need keys for the
# providers that appear in your REASONING_MODELS / VISION_MODELS chains below.
# The defaults span all five, so supplying more keys = more fallback headroom.
# A free Groq key + a free Gemini key is enough to run the whole app.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
# GitHub Models token. NOTE: GitHub Actions forbids secrets starting with
# GITHUB_, so CI maps GH_MODELS_TOKEN -> GITHUB_API_KEY (see workflows/eval.yml).
GITHUB_API_KEY=

# ── Model fallback chains (comma-separated, primary first) ───────────────────
# Override the built-in chains in backend/llm.py. Every reasoning model must
# support function calling; every vision model must accept image input.
# REASONING_MODELS=groq/llama-3.3-70b-versatile,openrouter/deepseek/deepseek-chat,cerebras/gpt-oss-120b,github/gpt-4o-mini,gemini/gemini-2.5-flash
# VISION_MODELS=gemini/gemini-2.5-flash,openrouter/qwen/qwen-2.5-vl-72b-instruct,github/gpt-4o-mini
# Eval LLM-as-judge chain; defaults to REASONING_MODELS when unset.
# JUDGE_MODELS=gemini/gemini-2.5-flash

# ── Execution mode ───────────────────────────────────────────────────────────
# USE_QUEUE=1 -> API enqueues onto arq and a separate worker runs the crew
#               (requires Redis). USE_QUEUE=0 -> API runs the crew in-process
#               (no Redis needed; simplest for local dev).
USE_QUEUE=0
REDIS_URL=redis://localhost:6379

# ── Browser / pool ───────────────────────────────────────────────────────────
# Headful is less bot-detectable; containers have no display so set 1 there.
BROWSER_HEADLESS=0
# Pre-warmed Chromium contexts in the worker's pool, and max in-flight jobs.
BROWSER_POOL_SIZE=2
# WORKER_CONCURRENCY defaults to BROWSER_POOL_SIZE if unset.
# WORKER_CONCURRENCY=2

# ── Agent behaviour ──────────────────────────────────────────────────────────
# Set-of-Marks grounding (numbered click targets). Set 0 to A/B against selectors.
SOM_ENABLED=1
# Split independent goals into parallel browser branches, capped at MAX.
PARALLEL_ENABLED=1
MAX_PARALLEL_BRANCHES=3
# Hard step cap per branch before the agent loop gives up.
EXECUTOR_MAX_STEPS=15
# How many recent tool exchanges to keep in the LLM context window.
HISTORY_WINDOW=6

# ── Timeouts (seconds) ───────────────────────────────────────────────────────
# How long a risky-action approval blocks before auto-denying.
APPROVAL_TIMEOUT_S=300
# Lease timeout when acquiring a browser from the pool.
POOL_ACQUIRE_TIMEOUT=120
# Hard ceiling arq gives one job before killing it.
JOB_TIMEOUT_S=600

# ── Observability ────────────────────────────────────────────────────────────
# Token/cost/latency accounting. Set 0 to disable for a zero-overhead hot path.
METRICS_ENABLED=1
You are a senior AI/ML engineer and technical recruiter specializing in GenAI roles. Your task is to conduct a brutally honest, comprehensive technical review of this project as if you were evaluating it for a GenAI job application from a fresher candidate in India.

Treat this review as if you're assessing whether this project demonstrates genuine GenAI competency and would be credible on a resume for entry-level GenAI roles at top companies.

**Review Structure:**

**Technical Depth & GenAI Implementation**You are a senior AI/ML engineer and technical recruiter specializing in GenAI roles. Your task is to conduct a brutally honest, comprehensive technical review of this project as if you were evaluating it for a GenAI job application from a fresher candidate in India.

Treat this review as if you're assessing whether this project demonstrates genuine GenAI competency and would be credible on a resume for entry-level GenAI roles at top companies.

**Review Structure:**

**Technical Depth & GenAI Implementation**
- Evaluate the actual GenAI/LLM implementation. Is it superficial (just calling an API) or does it show real understanding of prompting, model selection, fine-tuning, or RAG systems?
- Identify what's genuinely novel vs. what's standard practice
- Flag any misconceptions or technically incorrect approaches

**Code Quality & Engineering**
- Assess code organization, documentation, and maintainability
- Look for best practices in error handling, logging, and testing
- Would a senior engineer trust this code in production?

**Project Scope & Ambition**
- Is the scope appropriately ambitious for a fresher? Too small (just a demo)? Unrealistic (claiming to solve unsolved problems)?
- Does it solve a real problem or is it a generic use case?

**Resume Credibility**
- How would this look to a hiring manager? Would they ask follow-up technical questions or move on?
- What story can the candidate tell about this project in an interview?
- Are there red flags (overstated claims, vague descriptions, incomplete implementation)?
